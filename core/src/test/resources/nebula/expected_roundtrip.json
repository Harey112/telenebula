{
  "config": {
    "pki": {
      "blocklist": [],
      "disconnectInvalid": false,
      "initiatingVersion": 1
    },
    "staticHosts": [],
    "staticMap": {
      "cadence": "30s",
      "network": "ip4",
      "lookupTimeout": "250ms"
    },
    "lighthouse": {
      "interval": 60,
      "remoteAllowList": [],
      "localAllowList": [],
      "advertiseAddrs": [],
      "calculatedRemotes": []
    },
    "listen": {
      "host": "::",
      "port": 4242,
      "batch": 64,
      "readBuffer": 0,
      "writeBuffer": 0,
      "sendRecvError": "always",
      "acceptRecvError": "always",
      "udpOffloads": false
    },
    "routines": 1,
    "punchy": {
      "punch": true,
      "respond": true,
      "delay": "1s",
      "respondDelay": "5s"
    },
    "cipher": "aes",
    "preferredRanges": [],
    "sshd": {
      "isEnabled": false,
      "listen": "127.0.0.1:2222",
      "hostKey": "",
      "authorizedUsers": [],
      "trustedCas": []
    },
    "relay": {
      "relays": [],
      "amRelay": false,
      "useRelays": true
    },
    "tun": {
      "dropLocalBroadcast": true,
      "dropMulticast": true,
      "txQueue": 500,
      "mtu": 1300,
      "routes": [],
      "unsafeRoutes": []
    },
    "logging": {
      "format": "text",
      "disableTimestamp": false
    },
    "stats": {
      "type": "none",
      "prefix": "nebula",
      "protocol": "tcp",
      "host": "127.0.0.1:9999",
      "interval": "10s",
      "listen": "127.0.0.1:8080",
      "path": "/metrics",
      "namespace": "prometheusns",
      "subsystem": "nebula",
      "messageMetrics": false,
      "lighthouseMetrics": false
    },
    "handshakes": {
      "tryInterval": "100ms",
      "retries": 20,
      "queryBuffer": 64,
      "triggerBuffer": 64
    },
    "tunnels": {
      "dropInactive": false,
      "inactivityTimeout": "10m"
    },
    "firewall": {
      "outboundAction": "drop",
      "inboundAction": "drop",
      "defaultLocalCidrAny": false,
      "conntrack": {
        "tcpTimeout": "12m",
        "udpTimeout": "3m",
        "defaultTimeout": "10m"
      },
      "inbound": [],
      "outbound": []
    }
  },
  "errors": {}
}
